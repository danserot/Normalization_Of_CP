# Optional password protection. No external API keys are needed.
# APP_PASSWORD=replace-with-a-long-random-password
# APP_SECRET=replace-with-a-random-64-character-secret
COOKIE_SECURE=false
LOCAL_MODEL_ENABLED=true
# Optional local multimodal llama.cpp server on 127.0.0.1:8082 (alias local).
LOCAL_VISION_ENABLED=false
TESSERACT_LANG=rus+eng
