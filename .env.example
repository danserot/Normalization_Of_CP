# Required: put your OpenAI API key in the ignored repository-root .env file.
# Keep the key on the server. Never use VITE_OPENAI_API_KEY.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Empty means OPENAI_MODEL; another model must support images and Structured Outputs.
OPENAI_VISION_MODEL=
# Accepts the full Responses endpoint or an API base URL.
OPENAI_API_URL=https://api.openai.com/v1/responses
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_RETRIES=2
OPENAI_MAX_CONCURRENCY=4
OPENAI_VISION_CONCURRENCY=3
OPENAI_VISION_MAX_OUTPUT_TOKENS=14000
OPENAI_REASONING_EFFORT=minimal

# Every proposal uses OpenAI semantic review; no local inference fallback.
SEMANTIC_MODEL_MODE=always
SEMANTIC_CONTEXT_CHARS=60000
SEMANTIC_MAX_OUTPUT_TOKENS=8192
# All PDF pages are visually reviewed by default. Native cells stay authoritative.
VISION_PDF_MODE=always
VISION_RENDER_DPI=144
VISION_MAX_SIDE=2400
VISION_MAX_PAGES=50

EXTRACTION_TIMEOUT_SECONDS=300
EXTRACTION_WORKERS=3
EXTRACTION_QUEUE_LIMIT=8
EXTRACTION_QUEUE_WAIT_SECONDS=120
MAX_FILE_SIZE_MB=25
DEBUG_TIMINGS=false

# Optional password protection: set BOTH values for a public deployment.
# APP_PASSWORD=replace-with-a-long-random-password
# APP_SECRET=replace-with-a-random-64-character-secret
COOKIE_SECURE=false