# Required: put your OpenAI API key in the ignored repository-root .env file.
# Keep the key on the server. Never use VITE_OPENAI_API_KEY.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# The original file is sent directly; the model returns the complete proposal JSON.
OPENAI_API_URL=https://api.openai.com/v1/responses
# Optional explicit HTTP(S) proxy reachable from backend; system env proxies are not used.
OPENAI_PROXY_URL=
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_RETRIES=2
OPENAI_MAX_CONCURRENCY=4
OPENAI_REASONING_EFFORT=minimal
MODEL_DOCUMENT_MAX_OUTPUT_TOKENS=24000
# Applies to multi-frame image preparation, not PDF parsing.
VISION_MAX_PAGES=50

EXTRACTION_TIMEOUT_SECONDS=300
EXTRACTION_WORKERS=3
EXTRACTION_QUEUE_LIMIT=8
EXTRACTION_QUEUE_WAIT_SECONDS=120
MAX_FILE_SIZE_MB=25
DEBUG_TIMINGS=false

# Optional password protection: set BOTH values for a public deployment.
# APP_PASSWORD=replace-with-a-long-random-password
# APP_SECRET=replace-with-a-random-64-character-secret
COOKIE_SECURE=false
