# Uncomment and set both values to enable password-protected access.
# APP_PASSWORD=replace-with-a-long-random-password
# APP_SECRET=replace-with-a-random-64-character-secret

# Keep false only for localhost. Set true when served over HTTPS.
COOKIE_SECURE=false

# OpenAI API key. Keep the real key only in a local .env file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_API_URL=https://api.openai.com/v1
TESSERACT_LANG=rus+eng
TESSERACT_CONFIG=--oem 1 --psm 6 -c preserve_interword_spaces=1
